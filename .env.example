# Database. SQLite needs no setup; for PostGIS use:
# DATABASE_URL=postgresql+asyncpg://virasat:virasat@localhost:5432/virasat
DATABASE_URL=sqlite+aiosqlite:///./virasat.db

# Security. Required when APP_ENV=production.
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS. The bundled frontend is same-origin and does not need this.
ALLOWED_ORIGINS=http://localhost:8000

# App
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_MB=8

# Optional: Claude layer of the auto-tagger. Leave empty to use rules only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: dense search. Needs: pip install -r requirements-semantic.txt
# SEMANTIC_MODEL=paraphrase-multilingual-MiniLM-L12-v2
SEMANTIC_MODEL=

# Optional: only if tesseract is not on PATH, or language data lives elsewhere.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=./tessdata
TESSERACT_CMD=
TESSDATA_PREFIX=
